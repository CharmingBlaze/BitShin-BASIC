; Valley — a lake, meadows and forest in a ring of mountains that fade to blue
; with distance. Nothing here loads a file. The camera walks round the shore.
; Esc quits.

Graphics3D(1280, 720)
SetWindowTitle("moonBASIC — Valley")
cam = CreateCamera()
SetCameraRange(cam, 0.5, 4000)
sun = CreateDirectionalLight()
SetLightDirection(sun, 34, 40, 0)
SetLightColor(sun, 255, 238, 208)
SetLook "modern"
SetShadowDistance(900)
SetBloom 0.06
; The sky's low band and the fog share a color, so far ridges melt into the sky,
; and the fog is blue, so they turn blue on the way.
SetSkyGradient(92, 150, 218, 188, 212, 240)
SetFog(178, 200, 230, 320, 2600)
CreateVolumetricClouds(420, 620)
SetClouds(0.34, 0.8, 0.12)

; 1600 m across, peaks up to 480 m, the lake at 27% of that.
lake# = 129.6
hm = GenerateHeightmapPreset("valley", 512, 512, 11)
HydraulicErodeHeightmap(hm, 9000, 24)
ground = CreateTerrainFromHeightmap(hm, 1600, 1600, 480)
ApplyTerrainSplat(ground)
BakeTerrain(ground)
SetTerrainGrassCoverage(ground, 0.25)
SetTerrainWaterHeight(ground, lake + 0.8)
SetTerrainBlend(ground, 1.2)
SetTerrainRockColor(ground, 138, 120, 98)
SetTerrainSnow(True, 405)
SetTerrainStreamRadius(ground, 9)
; Past the map the hills reflect, so the land carries on into the haze.
SetTerrainEdge(ground, "mirror")
SetStreamOrigin(0, 0, 0)

water = CreateWater(4096, 4096, 96)
SetWaterLevel(lake)
SetWaterStyle("ocean")
SetWaterColor(26, 62, 92)
SetWaterShallow(44, 150, 150, 4)
SetWaterClarity(3)
SetWaterWaves(0)
SetWaterRoughness(0.3)
EnableWaterReflection(True)
EnableWaterRefraction(True)

SetTerrainClearings(ground, 1)
TerrainTrees(ground, CreateTree("pine", 1), 0.08)
TerrainTrees(ground, CreateTree("pine", 2, 24), 0.07)
TerrainTrees(ground, CreateTree("pine", 5, 16), 0.07)
TerrainTrees(ground, CreateTree("oak", 3), 0.04)
TerrainTrees(ground, CreateTree("oak", 4, 17), 0.03)
TerrainTrees(ground, CreateTree("oak", 6, 23), 0.02)
SetTerrainGrass(ground, 1)

a# = 200
walk# = 0
frames = 0
While 1
    frames = frames + 1
    a = a + 1.5 * Time.Delta()
    ; Walk out from the middle to the shore, then stand a little inland.
    dx# = Math.Sin(a)
    dz# = Math.Cos(a)
    r# = 60
    While r < 790 And TerrainHeight(ground, dx * r, dz * r) < lake + 1
        r = r + 6
    Wend
    r = r + 12
    If Abs(r - walk) > 3 And walk > 0 Then r = walk + Sgn(r - walk) * 3
    walk = r
    x# = dx * r
    z# = dz * r
    h# = TerrainHeight(ground, x, z)
    cam.Position(x, h + 30, z)
    ; Across the lake, toward the far side's mountains.
    CameraLookAt(cam, -dx * 1500, lake + 110, -dz * 1500)
    RenderWorld
    Flip
    If frames > 8
        If Input.KeyHit(KEY_ESCAPE) Then End
    EndIf
Wend
End
