; moon bench: the island, walked back and forth along its track at a run. It has to
; stand for a real game, so it has everything examples/island_walk.mb has.
Graphics3D(1280, 720)
@SETUP@
SetWindowTitle("moonBASIC benchmark: @NAME@. Please leave this running")
cam = CreateCamera()
SetCameraRange(cam, 0.15, 1800)
sun = CreateDirectionalLight()
SetLightDirection(sun, 42, 30, 0)
SetLightColor(sun, 255, 240, 214)
SetLook "modern"
SetShadowDistance(500)
SetBloom 0.12
SetSkyGradient(128, 178, 222, 196, 218, 236)
SetFog(196, 218, 236, 300, 1400)
SetClouds(0.32, 0.7, 0.12)

sea# = 48
hm = GenerateHeightmapPreset("mountain-island", 256, 256, 2026)
HydraulicErodeHeightmap(hm, 3200, 24)
ground = CreateTerrainFromHeightmap(hm, 800, 800, 160)
ApplyTerrainSplat(ground)
BakeTerrain(ground)
SetTerrainGrassCoverage(ground, 0.2)
SetTerrainWaterHeight(ground, sea + 0.8)
SetTerrainBlend(ground, 1.2)
SetTerrainRockColor(ground, 138, 120, 98)
SetTerrainSnow(True, 132)
SetTerrainStreamRadius(ground, 5)
CreateBodyHeightfield(ground)

water = CreateWater(4096, 4096, 96)
SetWaterLevel(sea)
SetWaterStyle("ocean")
SetWaterColor(30, 54, 96)
SetWaterShallow(30, 178, 178, 12)
SetWaterClarity(3)
SetWaterWaves(0)
EnableWaterReflection(True)
EnableWaterRefraction(True)

Dim bx(5)
Dim bz(5)
bx(0) = 40 : bz(0) = 262
bx(1) = 20 : bz(1) = 190
bx(2) = -40 : bz(2) = 110
bx(3) = -60 : bz(3) = 20
bx(4) = -40 : bz(4) = -90
For i = 0 To 3
    PaintTerrainPath(ground, bx(i), bz(i), bx(i + 1), bz(i + 1), 4)
Next

SetTerrainClearings(ground, 1)
TerrainTrees(ground, CreateTree("pine", 1), 0.14)
TerrainTrees(ground, CreateTree("pine", 2, 24), 0.12)
TerrainTrees(ground, CreateTree("oak", 3), 0.06)
TerrainTrees(ground, CreateTree("oak", 4, 17), 0.05)
SetTerrainGrass(ground, 1)

For i = 0 To 4
    b = CreateSphere().Scale(0.5, 0.5, 0.5).Position([bx(i), TerrainHeight(ground, bx(i), bz(i)) + 1.6, bz(i)])
    SetAlbedo(b, 30, 20, 10)
    SetEmissive(b, 800, 480, 180)
Next

sx# = 40
sz# = 292
player = CreatePivot().Position([sx, TerrainHeight(ground, sx, sz) + 2, sz])
CreateFPSController(player, cam, 1.75, 0.4, 5, 10, 7)
SetPlayer(player)
SetSwapInterval(0)

ti = 0
dir = 1
t# = 0
legT# = 0
While 1
    ax# = bx(ti) - EntityX(player)
    az# = bz(ti) - EntityZ(player)
    legT = legT + Time.Delta()
    ; On to the next point once there, or if a tree has held us up for too long.
    If ax * ax + az * az < 16 Or legT > 25
        legT = 0
        ti = ti + dir
        If ti > 4
            ti = 3
            dir = -1
        EndIf
        If ti < 0
            ti = 1
            dir = 1
        EndIf
    EndIf
    SetFPSLook(player, Math.ATan2(ax, az), 4)
    UpdateFPS(player, 0, 1, False, True, False, 0)
    t = t + Time.Delta()
    If t > @SECONDS@ Then End
    UpdateWorld
    RenderWorld
    Flip
Wend
End
