{
  "name": "bitshin-basic",
  "displayName": "BitShin BASIC",
  "description": "Language support and LSP client for BitShin BASIC (.bb)",
  "version": "0.1.0",
  "publisher": "bitshin",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:bitshinbasic"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "bitshinbasic",
        "aliases": ["BitShin BASIC", "BitShin", "bitshin"],
        "extensions": [".bb"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bitshinbasic",
        "scopeName": "source.bitshinbasic",
        "path": "./syntaxes/bitshinbasic.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "BitShin BASIC",
      "properties": {
        "bitshinbasic.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to bsls / bsls.exe (empty = search workspace then PATH, then bs lsp)"
        }
      }
    }
  }
}
