{
  "name": "moonbasic",
  "displayName": "moonBASIC",
  "description": "Language support and LSP client for moonBASIC (.mb)",
  "version": "1.0.0",
  "publisher": "moonbasic",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:moonbasic"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "moonbasic",
        "aliases": ["moonBASIC", "moonbasic"],
        "extensions": [".mb"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "moonbasic",
        "scopeName": "source.moonbasic",
        "path": "./syntaxes/moonbasic.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "moonBASIC",
      "properties": {
        "moonbasic.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to moonsls.exe (empty = search the workspace, then PATH, then moon lsp)"
        }
      }
    }
  }
}
