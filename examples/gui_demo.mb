; GUI demo — Dear ImGui on the same G3N GLFW window as the 3D scene.
; Spin / wireframe / rename the cube. Esc quits.

Graphics3D(800, 600)
SetWindowTitle("moonBASIC — GUI demo")
SetCameraClsColor(18, 22, 32)
SetAmbientLight(70, 80, 100)

; Camera / light
camera = CreateCamera().Position([0, 2, -6])
camera.Point(0, 0, 0)

light = CreateLight().Rotate(50, 30, 0)

; World
ground = CreatePlane(16, 16).Position([0, -1, 0]).Color(36, 42, 52)
cube = CreateCube().Position([0, 0.2, 0]).Color(70, 160, 255)

name$ = "cube"
spin# = 1
shade = 1
tintR = 70
tintG = 160
tintB = 255

; Loop
While Not Input.KeyDown(1)
    dt# = Time.Delta() * 60

    GuiBegin("Cube", 1)
    If GuiBeginMenuBar() Then
        If GuiMenu("File") Then
            If GuiMenuItem("Reset") Then
                spin# = 1
                shade = 1
                cube.Position(0, 0.2, 0)
            EndIf
            GuiEndMenu()
        EndIf
        GuiEndMenuBar()
    EndIf
    GuiText("cimgui-go on the Graphics3D window")
    GuiSeparator()
    spin# = GuiSlider("Spin", 0, 5, spin#)
    GuiTooltip("Degrees per frame")
    GuiProgress(spin# / 5, "spin")
    shade = GuiCombo("Shade", "Flat|Smooth|Wire", shade)
    wire = GuiCheckbox("Wireframe", wire)
    tintR = GuiColor("Tint", tintR, tintG, tintB)
    tintG = GuiColorG("Tint")
    tintB = GuiColorB("Tint")
    name$ = GuiInputText("Name", name$)
    GuiSameLine()
    If GuiButton("Reset") Then
        spin# = 1
        cube.Position(0, 0.2, 0)
    EndIf
    GuiEnd()

    useWire = wire
    If shade = 2 Then useWire = 1
    Wireframe(useWire)
    cube.Color(tintR, tintG, tintB)
    cube.Turn(0.4 * dt * spin#, 1 * dt * spin#, 0)
    cube.Name(name$)

    If WantCaptureMouse() Then
        ; mouse is on the panel — skip game clicks
    EndIf

    RenderWorld
    Flip
Wend
End
