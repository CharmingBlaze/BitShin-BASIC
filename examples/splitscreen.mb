; Splitscreen — two cameras, two viewports; click left view to CameraPick.
; Esc quits.

Graphics3D(800, 600)
SetBuffer(BackBuffer())
SetWindowTitle("moonBASIC — splitscreen")

; Left / right cameras
camL = CreateCamera()
camL.Position([-3, 2, -6])
SetCameraViewport(camL, 0, 0, 400, 600)

camR = CreateCamera()
camR.Position([3, 2, -6])
SetCameraViewport(camR, 400, 0, 400, 600)

; Scene
light = CreateLight()
ground = CreatePlane().Color(40, 48, 58)

a = CreateCube().Position([-2, 0.5, 4]).Color(255, 90, 90)
SetEntityRadius(a, 1)

b = CreateSphere().Position([2, 0.5, 4]).Color(80, 180, 255)
SetEntityRadius(b, 1)

While Not Input.KeyDown(KEY_ESCAPE)
    dt# = Time.Delta() * 60
    TurnEntity(a, 0, 0.6 * dt, 0)
    If Input.MouseHit(1) Then
        hit = CameraPick(camL, Input.MouseX(), Input.MouseY())
        If hit Then SetEntityColor(hit, Math.Rand(80, 255), Math.Rand(80, 255), Math.Rand(80, 255))
    EndIf
    UpdateWorld
    RenderWorld
    Text(12, 12, "Splitscreen  |  click left view  |  Picked=" + GetRayHitEntity())
    Flip
Wend
End
