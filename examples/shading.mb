; Shading modes — the same PBR material drawn lit, toon, and unlit.
; 1 / 2 / 3 switch the middle group. Up / Down change the toon bands.
; L steps through the colour LUT presets, O toggles ink outlines. Esc quits.

Graphics3D(1100, 640)
SetWindowTitle("moonBASIC — Shading modes")
SetAmbientLight(30, 34, 44)

cam = CreateCamera().Position([0, 4.2, -9])
cam.Point(0, 0.6, 3)

sun = CreateDirectionalLight()
SetLightDirection sun, 50, 35, 0
SetLightColor sun, 255, 236, 205
SetLightShadow sun, True
CreateSkyBox("default")
SetIBL True

ground = CreatePlane().Scale(20, 1, 20).Position([0, 0, 4])
SetMaterialPBR(ground, 1)
SetAlbedo(ground, 70, 92, 70)
SetRoughness(ground, 0.9)

; Left group: lit PBR. Middle group: toon. Right group: unlit.
Dim balls(9)
For row = 0 To 2
    For col = 0 To 2
        b = CreateSphere(24).Position([-4.6 + row * 4.6 + (col - 1) * 1.25, 0.6, 3 + (col - 1) * 1.4]).Scale(0.6, 0.6, 0.6)
        SetMaterialPBR(b, 1)
        If col = 0 Then SetAlbedo(b, 220, 80, 60)
        If col = 1 Then SetAlbedo(b, 80, 170, 230)
        If col = 2 Then SetAlbedo(b, 235, 200, 90)
        SetRoughness(b, 0.35)
        If col = 2 Then SetMetallic(b, 0.9)
        If row = 1 Then SetToon(b, 3, 0.5, 0.6)
        If row = 2 Then SetUnlit(b)
        balls(row * 3 + col) = b
    Next
Next

; A two-sided card with fog off, the Blitz way.
card = CreateQuad().Scale(1.4, 1.4, 1).Position([0, 2.6, 6.5])
RotateEntity(card, 90, 0, 0)
SetAlbedo(card, 255, 120, 200)
EntityFX(card, 1 + 8 + 16)

; Colour grading: a named preset here, or SetLUT("my_grade.cube").
lut = 1
SetLUT(LutName$(lut), 0.8)
outline = 1
SetOutline(1.5, 20, 16, 28)

bands = 3
mode$ = "toon"
While Not KeyHit(1)
    dt# = Time.Delta() * 60
    If KeyHit(2) Then mode$ = "pbr"
    If KeyHit(3) Then mode$ = "toon"
    If KeyHit(4) Then mode$ = "unlit"
    If KeyHit(200) And bands < 8 Then bands = bands + 1
    If KeyHit(208) And bands > 1 Then bands = bands - 1
    If KeyHit(38)
        lut = (lut + 1) Mod 6
        SetLUT(LutName$(lut), 0.8)
    EndIf
    If KeyHit(24)
        outline = 1 - outline
        SetOutline(outline * 1.5)
    EndIf
    For col = 0 To 2
        b = balls(3 + col)
        SetMaterialShading(b, mode$)
        If mode$ = "toon" Then SetToon(b, bands, 0.5, 0.6)
    Next
    For i = 0 To 8
        balls(i).Turn(0, 0.4 * dt, 0)
    Next
    Cls
    UpdateWorld
    RenderWorld
    Text(20, 18, "SHADING   left: PBR   middle: " + mode$ + "   right: unlit   pink card: EntityFX 1+8+16")
    Text(20, 42, "1 pbr  2 toon  3 unlit   Up/Down toon bands (" + bands + ")   L lut (" + LutName$(lut) + ")   O outline   Esc quit")
    Flip
Wend

Function LutName$(i)
    If i = 1 Then Return "teal_orange"
    If i = 2 Then Return "warm"
    If i = 3 Then Return "vintage"
    If i = 4 Then Return "bleach"
    If i = 5 Then Return "noir"
    Return "none"
End Function
