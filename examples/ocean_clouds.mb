; Ocean and clouds — swell, separate cloud cards, and a low mist you can swap.
; WASD orbit, Q/E pitch. 1 fair  2 rain  3 mist  4 storm. L lightning. Esc quits.

Graphics3D(1100, 700)
SetWindowTitle("moonBASIC — Ocean and clouds")
SetCameraClsColor(70, 120, 168)
SetAmbientLight(48, 62, 82)

; Camera / sky
cam = CreateCamera()
SetCameraRange(cam, 0.45, 4000)
CreateSkyBox("default")
SetSkyGradient(40, 110, 190, 170, 205, 230)
CreateAtmosphere()
SetAtmosphere(-0.35, 0.62, 0.70, 1.0, 1.05, 0.55)
clouds = CreateVolumetricClouds(80, 400)
SetClouds(0.46, 1.0, 0.2)

; Light
sun = CreateDirectionalLight()
SetLightDirection(sun, 28, 36, 8)
SetLightColor(sun, 255, 236, 200)

; Water
water = CreateWater(520, 520, 96)
SetWaterStyle("ocean")
SetWaterColor(6, 48, 72)
SetWaterWaves(4, 0.95)
SetGerstner(0, 0.88, 0.32, 0.42, 2.6, 42, 0.72)
SetGerstner(1, -0.22, 0.97, 0.32, 1.15, 22, 1.05)
SetGerstner(2, 0.62, -0.70, 0.28, 0.45, 9, 1.6)
SetGerstner(3, 0.18, 0.98, 0.2, 0.16, 3.4, 2.3)
SetWaterWind(0.85, 0.28, 0.72)
SetWaterSpeed(0.04)
SetWaterWaveStrength(0.04)
EnableWaterReflection(True)
EnableWaterRefraction(True)
SetWaterFollow(True)
SetWaterLevel(0)

; Isle / buoys — something to sit under the clouds
isle = CreateProcTerrain(4, 11, 4, 4.5, 24)
SetTerrainStreamRadius(isle, 3)

red = CreateCube().Scale(2.2, 3.2, 2.2).Position([8, 2, 6]).Color(210, 65, 50)
CreateBuoy(red)

ball = CreateSphere(12).Scale(2.4, 2.4, 2.4).Position([-6, 2, 5]).Color(240, 200, 60)
CreateBuoy(ball)

boat = CreateCube().Scale(3.2, 0.7, 1.4).Position([1, 1, -3]).Color(185, 95, 48)
CreateBuoy(boat)

; Loop
yaw# = 32
pitch# = 18
dist# = 26
frames = 0
While 1
    frames = frames + 1
    dt# = Time.Delta()
    If Input.KeyDown(KEY_A) Then yaw = yaw - 52 * dt
    If Input.KeyDown(KEY_D) Then yaw = yaw + 52 * dt
    If Input.KeyDown(KEY_W) Then dist = dist - 14 * dt
    If Input.KeyDown(KEY_S) Then dist = dist + 14 * dt
    If Input.KeyDown(KEY_Q) Then pitch = pitch + 26 * dt
    If Input.KeyDown(KEY_E) Then pitch = pitch - 26 * dt
    If dist < 14 Then dist = 14
    If dist > 110 Then dist = 110
    If pitch < 4 Then pitch = 4
    If pitch > 55 Then pitch = 55
    cx# = Math.Sin(yaw) * Math.Cos(pitch) * dist
    cz# = Math.Cos(yaw) * Math.Cos(pitch) * dist
    cy# = 2.2 + Math.Sin(pitch) * dist * 0.42
    cam.Position(cx, cy, cz)
    CameraLookAt(cam, 0, WaterHeight(0, 0) + 0.6, 4)

    If Input.KeyHit(KEY_1) Then SetWeather("clear")
    If Input.KeyHit(KEY_2) Then SetWeather("rain")
    If Input.KeyHit(KEY_3) Then SetWeather("fog")
    If Input.KeyHit(KEY_4) Then SetWeather("storm")
    If Input.KeyHit(KEY_L) Then StrikeLightning()

    Color 8, 16, 28, 190
    Rect 10, 8, 820, 52, 1
    Color 236, 242, 248
    Text(18, 14, "OCEAN + CLOUDS   WASD orbit   QE pitch   1 fair  2 rain  3 mist  4 storm  L bolt")
    Text(18, 34, "weather " + Weather$() + "   cover " + Str(GetCloudCoverage(clouds)) + "   Esc quit")
    RenderWorld
    Flip
    If frames > 8
        If Input.KeyHit(KEY_ESCAPE) Then End
    EndIf
Wend
End
