; Terrain sculpt — a tiny level editor on a heightmap terrain.
; Mouse picks the ground. Left raises, right lowers (or the mode's two actions).
; 1 sculpt  2 flatten  3 smooth  4 paint   Tab next paint layer
; [ ] brush size   - = brush strength   R reset   WASD pan   arrows orbit   Esc quit

Graphics3D(1280, 720)
SetWindowTitle("moonBASIC — Terrain Sculpt")
SetCameraClsColor(120, 165, 210)
SetAmbientLight(90, 94, 104)
EnableFog(True)
SetFog(150, 172, 192, 160, 700)
ShowPointer()
Color(255, 245, 220)

cam = CreateCamera()
SetCameraRange(cam, 0.25, 2000)
CreateSkyBox("default")
SetSkyPreset("default")

sun = CreateDirectionalLight()
SetLightDirection(sun, 42, 48, 12)
SetLightColor(sun, 255, 222, 180)

; Finite CPU heightmap: sculpting edits its grid in place.
hm = GenerateHeightmapPreset("rolling-hills", 129, 129, 7)
ground = CreateTerrainFromHeightmap(hm, 160, 160, 14)
ApplyTerrainSplat(ground)
SetTerrainGrassCoverage(ground, 0.7)
SetTerrainWaterHeight(ground, 1.5)
SetTerrainSnow(False)
SetTerrainStreamRadius(ground, 3)
SetStreamOrigin(0, 0, 0)

; Brush cursor
marker = CreateSphere()
ScaleEntity(marker, 0.4, 0.4, 0.4)
EntityColor(marker, 255, 90, 40)

mode = 1
layer = 1
radius# = 6
strength# = 0.5
flatY# = 0
picked = 0
px# = 0
py# = 0
pz# = 0

; Orbit camera around a focus point
fx# = 0
fz# = 0
yaw# = 30
pitch# = -38
dist# = 70
frames = 0

While 1
    frames = frames + 1
    dt# = Time.Delta()

    ; --- camera ---
    If Input.KeyDown(KEY_LEFT) Then yaw = yaw - 70 * dt
    If Input.KeyDown(KEY_RIGHT) Then yaw = yaw + 70 * dt
    If Input.KeyDown(KEY_UP) Then pitch = pitch - 40 * dt
    If Input.KeyDown(KEY_DOWN) Then pitch = pitch + 40 * dt
    If pitch > -10 Then pitch = -10
    If pitch < -85 Then pitch = -85
    ; Pan in the camera's heading: stand on the focus, face yaw, step, read back.
    pan# = 30 * dt
    mx# = 0
    mz# = 0
    If Input.KeyDown(KEY_W) Then mz = pan
    If Input.KeyDown(KEY_S) Then mz = -pan
    If Input.KeyDown(KEY_A) Then mx = -pan
    If Input.KeyDown(KEY_D) Then mx = pan
    cam.Position(fx, 0, fz)
    cam.Rotate(0, yaw, 0)
    cam.Move(mx, 0, mz)
    fx = EntityX(cam)
    fz = EntityZ(cam)
    ; Orbit: look down at pitch, then back off along the view axis.
    cam.Position(fx, TerrainHeight(fx, fz), fz)
    cam.Rotate(pitch, yaw, 0)
    cam.Move(0, 0, -dist)
    SetStreamOrigin(fx, 0, fz)

    ; --- tool keys ---
    If Input.KeyHit(KEY_1) Then mode = 1
    If Input.KeyHit(KEY_2) Then mode = 2
    If Input.KeyHit(KEY_3) Then mode = 3
    If Input.KeyHit(KEY_4) Then mode = 4
    If Input.KeyHit(KEY_TAB) Then
        layer = layer + 1
        If layer > 3 Then layer = 0
    EndIf
    If Input.KeyDown(KEY_LBRACKET) Then radius = radius - 8 * dt
    If Input.KeyDown(KEY_RBRACKET) Then radius = radius + 8 * dt
    If radius < 1 Then radius = 1
    If radius > 30 Then radius = 30
    If Input.KeyDown(KEY_MINUS) Then strength = strength - 0.6 * dt
    If Input.KeyDown(KEY_EQUALS) Then strength = strength + 0.6 * dt
    If strength < 0.05 Then strength = 0.05
    If strength > 1 Then strength = 1
    If Input.KeyHit(KEY_R) Then ResetTerrainEdits(ground)

    ; --- intro: the first 1.5 s carve and paint a rocky ring by themselves ---
    If frames < 90 Then
        a# = frames * 4
        SculptTerrain(ground, Cos(a) * 18, Sin(a) * 18, 5, 0.12, 0.6)
        PaintTerrain(ground, Cos(a) * 18, Sin(a) * 18, 5, 2, 0.2, 0.5)
    EndIf

    ; --- brush ---
    picked = PickTerrain(ground, Input.MouseX(), Input.MouseY())
    If picked Then
        px = PickedX()
        py = PickedY()
        pz = PickedZ()
        marker.Position(px, py + 0.3, pz)
        lmb = Input.MouseDown(1)
        rmb = Input.MouseDown(2)
        If mode = 1 Then
            If lmb Then SculptTerrain(ground, px, pz, radius, 6 * strength * dt, 0.6)
            If rmb Then SculptTerrain(ground, px, pz, radius, -6 * strength * dt, 0.6)
        EndIf
        If mode = 2 Then
            ; right click samples the height, left click flattens toward it
            If rmb Then flatY = py
            If lmb Then FlattenTerrain(ground, px, pz, radius, flatY, 4 * strength * dt, 0.4)
        EndIf
        If mode = 3 Then
            If lmb Or rmb Then SmoothTerrain(ground, px, pz, radius, 6 * strength * dt, 0.5)
        EndIf
        If mode = 4 Then
            If lmb Then PaintTerrain(ground, px, pz, radius, layer, 3 * strength * dt, 0.5)
            If rmb Then PaintTerrain(ground, px, pz, radius, -1, 3 * strength * dt, 0.5)
        EndIf
    EndIf

    ; --- HUD ---
    tool$ = "SCULPT  left raise / right lower"
    If mode = 2 Then tool$ = "FLATTEN  right pick height / left flatten to " + Str(Int(flatY * 10) / 10.0)
    If mode = 3 Then tool$ = "SMOOTH  left or right"
    If mode = 4 Then
        lname$ = "sand"
        If layer = 1 Then lname$ = "grass"
        If layer = 2 Then lname$ = "rock"
        If layer = 3 Then lname$ = "snow"
        tool$ = "PAINT " + lname$ + "  left paint / right erase  Tab next layer"
    EndIf

    Cls
    Text(12, 12, "TERRAIN SCULPT  1 sculpt  2 flatten  3 smooth  4 paint   [ ] size  - = strength  R reset")
    Text(12, 32, "WASD pan  arrows orbit  Esc quit")
    Text(12, 56, tool$)
    Text(12, 76, "radius=" + Str(Int(radius)) + "  strength=" + Str(Int(strength * 100)) + "%  slope=" + Str(Int(TerrainSlope(px, pz) * 100) / 100.0) + "  fps=" + Str(StatsFPS()))
    RenderWorld
    Flip
    If frames > 8
        If Input.KeyHit(KEY_ESCAPE) Then End
    EndIf
Wend
End
